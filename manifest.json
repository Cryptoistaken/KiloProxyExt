{
  "manifest_version": 3,
  "name": "KiloProxy",
  "version": "2.0.0",
  "description": "Save proxies, switch with one click. No server, no tracking.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "KiloProxy", "default_popup": "src/popup/popup.html" }
}
